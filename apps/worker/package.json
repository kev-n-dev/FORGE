{
  "name": "@guild/worker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev --local",
    "build": "tsc -p tsconfig.json --noEmit && wrangler deploy --dry-run",
    "deploy:staging": "wrangler deploy --env staging",
    "deploy:production": "wrangler deploy --env production",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "lint": "eslint src --ext .ts",
    "clean": "rm -rf dist .wrangler *.tsbuildinfo"
  },
  "dependencies": {
    "@guild/auth": "workspace:*",
    "@guild/config": "workspace:*",
    "@guild/database": "workspace:*",
    "@guild/types": "workspace:*",
    "@guild/validation": "workspace:*",
    "hono": "^4.6.3",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20240925.0",
    "@cloudflare/vitest-pool-workers": "^0.5.16",
    "typescript": "^5.5.4",
    "vitest": "^2.0.5",
    "wrangler": "^3.75.0"
  }
}
