{
  "name": "@guild/database",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    }
  },
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "migrate:local": "wrangler d1 migrations apply forge-db --local",
    "migrate:remote": "wrangler d1 migrations apply forge-db --remote",
    "seed:local": "wrangler d1 execute forge-db --local --file=../../scripts/seed.sql",
    "generate:migration": "node scripts/generate-migration.mjs",
    "clean": "rm -rf dist *.tsbuildinfo"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20240925.0",
    "typescript": "^5.5.4",
    "wrangler": "^3.75.0"
  }
}
