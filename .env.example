# FORGE — Root environment variables example
# Copy to .env for local development.
# NEVER commit .env or .dev.vars to version control.

# ---------------------------------------------------------------------------
# Cloudflare Worker secrets
# Set these via: wrangler secret put <NAME>
# Or place in apps/worker/.dev.vars for local development
# ---------------------------------------------------------------------------

# Required: 32+ character random string for JWT signing
# Generate: openssl rand -base64 32
AUTH_SECRET=REPLACE_WITH_STRONG_RANDOM_SECRET_MIN_32_CHARS

# Required: Cloudflare Turnstile secret key
# https://dash.cloudflare.com/?to=/:account/turnstile
TURNSTILE_SECRET=REPLACE_WITH_TURNSTILE_SECRET_KEY

# ---------------------------------------------------------------------------
# Cloudflare resource IDs
# Found in: Cloudflare dashboard → Workers & Pages / D1 / KV / R2
# ---------------------------------------------------------------------------
D1_DATABASE_ID=REPLACE_WITH_D1_DATABASE_ID
SESSION_KV_ID=REPLACE_WITH_SESSION_KV_NAMESPACE_ID
CACHE_KV_ID=REPLACE_WITH_CACHE_KV_ID

# ---------------------------------------------------------------------------
# Frontend (Vite)
# These are embedded in the built bundle — never put secrets here
# ---------------------------------------------------------------------------
VITE_API_BASE_URL=/api
VITE_TURNSTILE_SITE_KEY=1x00000000000000000000AA
VITE_ENVIRONMENT=development
